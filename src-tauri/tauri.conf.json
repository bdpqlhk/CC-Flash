{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC-Flash",
  "identifier": "com.ccflash.app",
  "mainBinaryName": "CC-Flash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http:; font-src 'self' data:; connect-src 'self' ipc: http: ws: http://ipc.localhost https://api.github.com; media-src 'self' blob: http:; frame-src 'self' http:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "android": {
      "versionCode": 10200300
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
